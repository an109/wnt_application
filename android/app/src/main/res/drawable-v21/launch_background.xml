<?xml version="1.0" encoding="utf-8"?>
<!-- Window background shown while the Flutter engine boots, before its first
     frame. Painted in the Flutter splash's own navy so the two are
     indistinguishable; it used to be ?android:colorBackground, which resolves
     to black under the dark-mode theme — that black window is what appeared
     before the splash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
